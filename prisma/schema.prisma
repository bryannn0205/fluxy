// Prisma schema do Fluxy.
// Ver .claude/docs/architecture/multi-tenant.md antes de alterar qualquer modelo.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// TENANT & ASSINATURA
// =============================================================================

model Company {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  cnpj  String? @unique
  phone String?

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime

  // DÍVIDA TÉCNICA: resquício de um provedor que nunca chegou a ser integrado.
  //
  // Mantidas de propósito, e NÃO renomeadas. Renomear preservaria os bytes mas
  // trocaria o significado: um identificador do Asaas passaria a se chamar
  // ValidaPay, e ninguém perceberia. Nenhum código deste repositório jamais
  // escreveu aqui — o que prova que o SISTEMA não preencheu, não que nenhum
  // banco tenha valor, porque alteração manual fora do repositório não pode
  // ser descartada.
  //
  // A remoção fica para migration própria, DEPOIS de verificar explicitamente
  // o banco de produção.
  asaasCustomerId     String?
  asaasSubscriptionId String?

  // Identificadores da empresa na ValidaPay.
  //
  // Nome EXPLÍCITO, e não `paymentProvider*`: sem uma coluna de provider ao
  // lado, o nome genérico não permitiria interpretar de quem é o
  // identificador — seria específico da ValidaPay escondendo isso no nome.
  // `SubscriptionCheckout` e `PaymentProviderEvent` usam a enum porque lá o
  // provedor é parte do dado; aqui não é, e o MVP tem um gateway só.
  //
  // Nascem NULL. Nada é copiado das colunas acima: o dado de um provedor não
  // vira dado de outro por mudança de nome.
  validapayCustomerId     String?
  validapaySubscriptionId String?

  // Contador atômico para gerar o próximo número de pedido da empresa.
  nextOrderNumber Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subscriptionCheckouts SubscriptionCheckout[]
  providerEvents        PaymentProviderEvent[]

  users          User[]
  customers      Customer[]
  products       Product[]
  orders         Order[]
  auditLogs      AuditLog[]
  attachments    OrderAttachment[]
  stockMovements StockMovement[]
  invitations    Invitation[]
  notifications  Notification[]
  payments       Payment[]

  @@index([deletedAt])
  /// Uma assinatura da ValidaPay pertence a UMA empresa.
  ///
  /// Único, e não apenas índice: duas empresas apontando para a mesma assinatura
  /// é dado corrompido, e o webhook teria de escolher qual delas cancelar. A
  /// restrição impede a corrupção em vez de deixar o código lidar com ela.
  ///
  /// **Múltiplos NULL são permitidos** — no PostgreSQL, `NULL` não é igual a
  /// `NULL` num índice único, então toda empresa sem assinatura convive sem
  /// conflito. É o caso da maioria: quem está em teste nunca teve assinatura.
  ///
  /// Também serve à consulta: a correlação de webhook e a varredura agendada
  /// buscam por esta coluna, e sem índice seriam varredura de tabela.
  @@unique([validapaySubscriptionId])
}

// Modela o plano de assinatura e quais módulos ele libera.
// V1 tem um único Plan com todos os módulos — a estrutura já existe para
// suportar tiers futuros (ex.: módulos de ERP vendidos separadamente) sem
// exigir refatoração do gate de acesso. Ver .claude/docs/project/product.md.
model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal  @db.Decimal(10, 2)
  // Capacidades BINÁRIAS (EXPORT, FULL_REPORTS, AUTOMATIONS). As colunas
  // abaixo respondem "quantos"; esta responde "tem ou não tem". Nenhuma
  // duplica a outra — não crie booleano aqui para algo que já é módulo.
  modules      String[]

  // Limites QUANTITATIVOS.
  //   null     = ilimitado
  //   0        = recurso bloqueado
  //   positivo = teto
  //
  // Nascem null e assim ficam até um passo comercial separado preenchê-los
  // por UPDATE — a migration não muda o comportamento de ninguém. São valores
  // de negócio, ajustáveis no banco sem nova migration.
  //
  // maxAttachmentsPerOrder está FORA de propósito: o limite de anexos depende
  // de consistência entre Postgres e R2 e será tratado em fase própria. Criar
  // a coluna agora seria abrir espaço para um teto que ninguém aplica.
  maxUsers          Int?
  maxOrdersPerMonth Int?
  maxProducts       Int?
  maxCustomers      Int?

  // Preços correspondentes na ValidaPay (`priceId` de POST /v1/checkout-sessions).
  //
  // Nullable e INDEPENDENTES: um plano pode ter só o mensal cadastrado lá, e
  // Standard e Pro têm identificadores distintos. Ficam no banco, e não em
  // constante no código, porque são identificadores de um sistema externo —
  // mudam por ação de quem administra a conta, não por deploy.
  //
  // Nome explícito pela mesma razão das colunas de Company.
  //
  // A F2 apenas abre as colunas. Criar produto e preço remotos é fase própria.
  validapayPriceMonthlyId String?
  validapayPriceYearlyId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies             Company[]
  subscriptionCheckouts SubscriptionCheckout[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

// =============================================================================
// IDENTIDADE & AUTENTICAÇÃO (Auth.js — PrismaAdapter + sessão JWT)
// =============================================================================

model User {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  // Globalmente único: o PrismaAdapter do Auth.js resolve usuários por
  // e-mail sem escopo de tenant. Ver nota em lib/auth.ts.
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Nulo para usuários que só entram via OAuth (Google).
  passwordHash  String?
  role          Role      @default(OWNER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // Pedidos criados por este usuário e anexos enviados por ele — ambos
  // preservados mesmo se o usuário for desativado (soft delete), nunca
  // apagados em cascata: são registros de negócio, não dados descartáveis.
  createdOrders       Order[]
  uploadedAttachments OrderAttachment[]
  stockMovements      StockMovement[]
  sentInvitations     Invitation[]

  // Recebidas e causadas: dois lados distintos da mesma tabela, por isso as
  // relações são nomeadas.
  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  registeredPayments     Payment[]

  // Alvo da FK composta de Payment — ver a nota equivalente em Order.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([deletedAt])
}

// Ordenados do mais para o menos poderoso — a ordem é semântica, e
// `lib/permissions.ts` é quem diz o que cada um pode. Não existe papel
// PRODUCTION: será avaliado quando a área de produção for ampliada.
enum Role {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  FINANCE
  VIEWER
}

// Convite pendente para um novo membro da equipe. Representa só o estado
// PENDENTE — ao ser aceito, vira um User e esta linha é apagada (o rastro
// permanece no AuditLog, não aqui). Isso mantém @@unique([companyId, email])
// significando exatamente "só um convite pendente por e-mail", sem precisar
// de índice parcial para ignorar convites já aceitos.
model Invitation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email String
  role  Role   @default(OPERATOR)
  token String @unique

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([companyId, email])
  @@index([companyId])
}

// Tabelas exigidas pelo contrato do @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Não usada para leitura de sessão (estratégia é JWT), mas exigida pelo
// contrato de tipos do PrismaAdapter. Ver .claude/docs/tech-stack/third-party.md.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// CLIENTES
// =============================================================================

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  email    String?
  phone    String?
  document String? // CPF ou CNPJ, apenas dígitos
  address  String?
  notes    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders Order[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
}

// =============================================================================
// PRODUTOS
// =============================================================================

model Product {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  unit        String  @default("UN")
  active      Boolean @default(true)

  // Custo de aquisição/produção — opcional porque produtos existentes não
  // têm esse dado retroativamente; a margem só é exibida quando presente.
  costPrice Decimal? @db.Decimal(10, 2)

  // Nunca escrito diretamente fora de StockService — toda variação deve
  // gerar um StockMovement correspondente (ver StockRepository), para que
  // o saldo seja sempre reconstruível a partir do ledger.
  stockQuantity Int @default(0)

  // Nulo = sem alerta de estoque baixo para este produto.
  lowStockThreshold Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, deletedAt])
  @@index([companyId, active])
}

// Ledger append-only de todas as variações de estoque — nunca UPDATE,
// sempre INSERT. Product.stockQuantity é uma soma-cache do histórico aqui,
// não a fonte de verdade: em caso de dúvida, o saldo é reconstruível
// somando quantityDelta de todos os registros de um produto.
model StockMovement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  reason StockMovementReason

  // Positivo = entrada, negativo = saída. Nunca zero (ver StockService).
  quantityDelta Int
  // Saldo de Product.stockQuantity resultante deste movimento — denormalizado
  // para exibir o histórico sem recalcular a soma corrida a cada leitura.
  balanceAfter  Int

  // Observação livre — relevante para RESTOCK/ADJUSTMENT (ex.: "Compra NF
  // 1234", "Contagem mensal", "Avaria no transporte"); ausente em SALE/
  // CANCELLATION, cuja origem já é o orderId.
  note String?

  // Presente quando o movimento foi gerado automaticamente por um pedido
  // (SALE na criação, CANCELLATION no cancelamento/exclusão).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, productId, createdAt(sort: Desc)])
  @@index([orderId])
}

enum StockMovementReason {
  SALE
  CANCELLATION
  RESTOCK
  ADJUSTMENT
}

// =============================================================================
// PEDIDOS
// =============================================================================

model Order {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Gerado a partir de Company.nextOrderNumber — nunca reaproveitado após
  // exclusão (soft delete), o que preserva rastreabilidade fiscal.
  orderNumber String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  // total = subtotal + deliveryFee + surcharge - discount. O cálculo vive em
  // lib/order-totals.ts e em nenhum outro lugar — nem no formulário, nem no
  // CSV, nem no relatório. Ver a nota lá sobre por que o servidor recalcula
  // sempre a partir do preço do Product, ignorando qualquer total do cliente.
  deliveryFee Decimal     @default(0) @db.Decimal(10, 2)
  surcharge   Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  notes       String?

  // Caches do ledger de Payment, reconstruíveis somando os lançamentos —
  // mesma relação que Product.stockQuantity tem com StockMovement.
  //
  // Escritos SÓ pelo FinanceService e pelo cancelamento transacional, sempre
  // dentro da transação que grava o Payment correspondente. Ficam fora dos
  // schemas Zod de edição de pedido de propósito: nenhum input do usuário
  // pode alcançá-los.
  paidAmount    Decimal            @default(0) @db.Decimal(10, 2)
  paymentStatus OrderPaymentStatus @default(PENDING)

  // Vencimento. Mesma convenção de expectedDeliveryDate — meia-noite UTC do
  // dia escolhido —, o que deixa isOverdue() de lib/dates.ts servir aos dois
  // sem ramificação. Semanticamente é data; o horário é sempre 00:00.
  dueDate DateTime?

  priority             OrderPriority  @default(NORMAL)
  expectedDeliveryDate DateTime?
  paymentMethod        PaymentMethod?

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  items          OrderItem[]
  auditLogs      AuditLog[]
  attachments    OrderAttachment[]
  stockMovements StockMovement[]
  notifications  Notification[]
  payments       Payment[]

  // Alvo da FK composta de Payment. Redundante quanto à unicidade (id já é a
  // chave primária) — existe só para o Postgres poder referenciar o par
  // (id, companyId) e tornar impossível um pagamento apontar para pedido de
  // outra empresa. A chave primária continua sendo `id` sozinho.
  @@unique([id, companyId])
  @@unique([companyId, orderNumber])
  @@index([companyId, status, priority])
  @@index([companyId, createdAt(sort: Desc)])
  // Serve "contas a receber" e o filtro de atraso, ambos liderados por
  // empresa. Criado na migration do financeiro; declarado aqui para o schema
  // não divergir do banco — sem esta linha, o próximo `migrate dev` o derruba.
  @@index([companyId, paymentStatus, dueDate])
  @@index([companyId, expectedDeliveryDate])
  @@index([companyId, deletedAt])
  @@index([customerId])
  @@index([createdById])
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  CASH
  BANK_TRANSFER
  OTHER
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Denormalizado para reforçar isolamento de tenant mesmo em queries
  // diretas em OrderItem. Ver .claude/docs/architecture/multi-tenant.md.
  companyId String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Nome e preço são um snapshot do momento da venda — o pedido não pode
  // mudar silenciosamente se o produto for renomeado ou reprecificado depois.
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  total       Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([companyId])
}

// =============================================================================
// AUDITORIA
// =============================================================================

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  resource   String
  resourceId String
  changes    Json?
  ip         String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, resource, resourceId])
  // Lidera com orderId (não companyId): serve o include aninhado
  // Order.auditLogs, cujo tenant já foi verificado pela query pai — ver
  // OrderRepository.findById. Diferente dos outros índices deste model,
  // que servem consultas de topo (sempre lideradas por companyId).
  @@index([orderId, createdAt(sort: Desc)])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
}

// =============================================================================
// ANEXOS DE PEDIDO
// =============================================================================

// Armazenado no Cloudflare R2 (ver lib/r2.ts) — fileKey é só a chave do
// objeto, nunca a URL completa, para não exigir migração de dados se o
// domínio/CDN público mudar no futuro.
model OrderAttachment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  category  AttachmentCategory
  fileName  String
  fileKey   String
  mimeType  String
  sizeBytes Int

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([orderId])
  @@index([companyId, deletedAt])
}

enum AttachmentCategory {
  NOTA
  FOTO
  DOCUMENTO
  ARTE_CLIENTE
  OUTRO
}

// =============================================================================
// NOTIFICAÇÕES
// =============================================================================

// Uma linha por destinatário. O estado de "lido" é individual, então avisar
// uma equipe de cinco pessoas grava cinco linhas. A alternativa — uma linha
// só, mais uma tabela de leituras — economiza espaço mas cobra um join em
// toda listagem; para equipes do tamanho que este produto atende, o
// fan-out na escrita é o lado certo do trade-off.
//
// **Só eventos entram aqui, nunca condições.** "Estoque baixo" e "pedido
// atrasado" são estado corrente, e o Painel os deriva por query. Gravá-los
// como linha exigiria apagar a notificação quando a condição cessasse, e
// reexecutar a checagem duplicaria o aviso — ver StockService e getStats.
model Notification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Cascade: notificação sem destinatário não significa nada. Diferente dos
  // registros de negócio (pedidos, anexos), que sobrevivem à saída do usuário.
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // Quem causou o evento — nulo quando a origem é o próprio sistema.
  // Sem cascade: a notificação continua válida mesmo se o autor sair da equipe.
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id])

  type NotificationType

  // Snapshot do que a linha precisa exibir (número do pedido, nome do
  // cliente). Ler das relações a cada listagem custaria join e mostraria o
  // estado de hoje num registro do que aconteceu ontem — o texto de uma
  // notificação é histórico e não deve mudar sob os pés de quem leu.
  data Json

  // Só para o link "ver pedido". A relação existe para não acumular id
  // pendurado; pedidos são excluídos por soft delete, então o cascade
  // nunca dispara na prática.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Serve a listagem do sino (destinatário + mais recentes primeiro).
  @@index([userId, createdAt(sort: Desc)])
  // Serve o contador de não lidas do badge, sem tocar nas linhas já lidas.
  @@index([userId, readAt])
}

// Um único tipo para mudança de status, com o status novo dentro de `data`,
// em vez de um valor de enum por status: acrescentar uma etapa ao fluxo do
// pedido não deve exigir migração de banco.
enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_DELETED
}

// =============================================================================
// FINANCEIRO DOS PEDIDOS
// =============================================================================

// Ledger append-only de recebimentos e estornos de um pedido. Nunca UPDATE,
// nunca DELETE: corrigir um lançamento é registrar o oposto, e o erro
// permanece visível — que é o que uma conferência contábil exige.
//
// **Nada aqui tem relação com a assinatura que a empresa paga pelo Fluxy.**
// Aquilo vive em Company.subscriptionStatus e nos campos de provedor. São dois
// fluxos de dinheiro em direções opostas; misturá-los faria o faturamento da
// empresa somar a própria mensalidade.
model Payment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Chaves compostas com companyId: o pedido e o autor precisam pertencer à
  // MESMA empresa do pagamento. Não é validação de código que alguém pode
  // esquecer de chamar — é impossibilidade estrutural, recusada pelo Postgres.
  //
  // Restrict nos dois sentidos: o ledger não some junto com uma exclusão
  // física acidental (onDelete), e não acompanha troca de identificador ou de
  // tenant (onUpdate). Mover pagamento entre empresas, se um dia for preciso,
  // será um processo explícito e auditado — nunca um efeito colateral de
  // cascata.
  orderId String
  order   Order  @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  createdById String
  createdBy   User   @relation(fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  type PaymentType

  // SEMPRE positivo — há CHECK no banco, além do Zod e do FinanceService.
  // O sinal vem do `type`, nunca do número: guardar negativo permitiria um
  // REFUND de valor negativo, que somaria em vez de subtrair.
  amount Decimal @db.Decimal(10, 2)

  // Método deste recebimento, não o do pedido. Metade no PIX e metade em
  // dinheiro são dois Payment com métodos diferentes — Order.paymentMethod
  // é só a forma combinada, e não prova nada sobre o que entrou.
  method PaymentMethod

  // Quando o dinheiro entrou de fato, que pode não ser quando foi lançado no
  // sistema: PIX de sábado é conciliado na segunda.
  paidAt DateTime

  // Obrigatória em REFUND (validada no Zod e no FinanceService): estorno sem
  // motivo escrito é rastro inútil na hora de auditar.
  note String?

  // Gerada pelo cliente ao abrir o formulário, não derivada dos dados — dois
  // recebimentos legítimos de R$ 50 no PIX no mesmo minuto são normais. O
  // índice único é a garantia contra clique duplo; a checagem no service é
  // otimização.
  idempotencyKey String

  createdAt DateTime @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, orderId, paidAt(sort: Desc)])
  @@index([companyId, paidAt(sort: Desc)])
}

enum PaymentType {
  PAYMENT
  REFUND
}

// "Atrasado" NÃO entra aqui de propósito: é condição (dueDate vencida e ainda
// falta pagar), não fato com hora marcada. Gravá-lo exigiria um job noturno
// virando pedidos, outro desvirando quando alguém pagasse, e entre a
// meia-noite e o job o sistema mentiria. Derivado por isOverdue(), está sempre
// certo. Mesma regra que vale para notificações — ver STATUS.md.
enum OrderPaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

// ============================================================
// Integração com provedor de pagamento
// ============================================================

// Um valor só, e é o suficiente. Existe para que as tabelas acima possam ter
// nomes neutros com honestidade: sem esta coluna, "PaymentProviderEvent" seria
// um nome genérico escondendo um acoplamento. Quando houver um segundo
// provedor, ele entra aqui e nada mais precisa ser renomeado.
enum PaymentProvider {
  VALIDAPAY
}

// Contraparte no banco de BILLING_INTERVALS (lib/constants.ts). Enum, e não
// texto livre, porque uma periodicidade desconhecida gravada por engano só
// apareceria na hora de cobrar.
enum BillingInterval {
  MONTHLY
  YEARLY
}

// Estado da TENTATIVA de contratação — distinto de SubscriptionStatus, que é o
// estado da assinatura da empresa. Reutilizar aquele enum aqui faria uma
// tentativa abandonada parecer uma assinatura cancelada.
enum SubscriptionCheckoutStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ProviderEventStatus {
  PENDING
  PROCESSED
  FAILED
  // Evento legítimo que não exige ação: tipo desconhecido, duplicado
  // semântico, ou referente a algo que o Fluxy não acompanha. Registrado para
  // auditoria, nunca reprocessado.
  IGNORED
}

/// Tentativa de contratação, registrada ANTES do redirecionamento ao checkout.
///
/// Existe para uma coisa: dar ao Fluxy um registro PRÓPRIO com que correlacionar
/// o webhook que chegará depois. Sem ele, a correlação dependeria de campo do
/// payload — isto é, de dado que vem de fora — e um payload forjado poderia
/// apontar para a empresa que quisesse.
///
/// **`intendedPlanId` é intenção, não plano efetivo.** Criar uma tentativa não
/// altera `Company.planId` nem `Company.subscriptionStatus`; nada nesta tabela
/// concede acesso. O plano vigente continua sendo o de `Company`, e só muda
/// depois de pagamento confirmado.
model SubscriptionCheckout {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Plano PRETENDIDO. Restrict: um plano com tentativa registrada não some do
  /// catálogo sem que alguém decida o que fazer com o histórico.
  intendedPlanId String
  intendedPlan   Plan   @relation(fields: [intendedPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  billingInterval BillingInterval
  provider        PaymentProvider

  /// Identificadores devolvidos pelo provedor ao abrir o checkout. Nullable
  /// porque a linha nasce ANTES da chamada externa — é justamente o registro
  /// que sobrevive caso a chamada falhe.
  externalSessionId String?
  externalChargeId  String?

  status SubscriptionCheckoutStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  /// Únicos POR PROVEDOR, não globalmente.
  ///
  /// Dois registros do Fluxy apontando para a mesma sessão tornariam a
  /// correlação ambígua justamente na hora de conceder o plano — daí o único.
  /// Mas o identificador é de um sistema de terceiro: nada documentado garante
  /// que ele não colida com o de outro provedor, e assumir unicidade global de
  /// um formato que não controlamos criaria uma falha de inserção inexplicável
  /// no dia em que houvesse um segundo gateway. `provider` faz parte do dado
  /// aqui, então faz parte da chave.
  @@unique([provider, externalSessionId])
  @@unique([provider, externalChargeId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
}

/// Eventos recebidos do provedor. **Append-only**, como StockMovement e Payment.
///
/// A linha é gravada antes de qualquer efeito, e o efeito vem depois: um evento
/// que falhe ao ser processado continua registrado, com `status = FAILED`, em
/// vez de sumir. É o que permite reprocessar sem depender de reenvio.
///
/// **Sem PII.** Não há coluna para `taxId`, conta, agência, banco ou dado de
/// cartão — o payload de `payment.success` traz isso, e nada obriga o Fluxy a
/// guardar. O que se guarda é o mínimo para correlacionar e auditar.
model PaymentProviderEvent {
  id       String          @id @default(cuid())
  provider PaymentProvider

  /// Identificador do evento no provedor. **Nullable** porque a ValidaPay não
  /// documenta um: se vier no payload real, passa a ser preenchido e vira a
  /// base natural da idempotência. Ver `idempotencyKey`.
  externalEventId String?

  /// Texto, e NÃO enum. Um tipo de evento desconhecido precisa ser gravável:
  /// com enum, o Postgres recusaria a linha e o Fluxy perderia justamente o
  /// registro de que algo novo apareceu. A tradução para comportamento é
  /// decidida no código, que sabe ignorar o que não conhece.
  eventType String

  /// Nullable: um evento pode chegar sem correlação possível — cobrança
  /// desconhecida, ou anterior a este sistema. Guardar mesmo assim é o que
  /// permite investigar. Evento sem empresa NUNCA aparece em consulta de
  /// tenant; só em consulta administrativa.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  externalChargeId       String?
  externalPaymentId      String?
  externalSubscriptionId String?

  /// Quando aconteceu no provedor (nullable — nem todo evento traz) e quando
  /// chegou aqui. Separados de propósito: é a diferença entre os dois que
  /// denuncia entrega fora de ordem.
  occurredAt DateTime?
  receivedAt DateTime  @default(now())

  processedAt DateTime?
  status      ProviderEventStatus @default(PENDING)

  /// A garantia estrutural contra processar o mesmo evento duas vezes.
  ///
  /// **A fórmula NÃO está fechada.** A ValidaPay não documenta identificador de
  /// evento, então a chave será derivada do payload real na fase de webhook —
  /// provavelmente algo como `<eventType>:<externalPaymentId>`, mas isso só se
  /// decide com exemplos em mãos. O que já está decidido é que ela existe, é
  /// única no banco, e não pode ser apenas `eventType`: dois pagamentos
  /// distintos geram dois `payment.success`, e colidir os dois descartaria um
  /// pagamento real.
  ///
  /// A unicidade é composta com `provider` — ver `@@unique` abaixo. Não há
  /// invariante testada de que a chave derivada contenha o provedor, e supor
  /// isso é justamente o tipo de premissa não documentada que se paga caro.
  idempotencyKey String

  /// Hash do payload recebido, para detectar reenvio com conteúdo alterado sem
  /// guardar o conteúdo. Nullable até a fase de webhook definir o que entra no
  /// hash.
  payloadHash String?

  /// A garantia estrutural contra processar o mesmo evento duas vezes,
  /// escopada ao provedor pela mesma razão dos identificadores externos em
  /// SubscriptionCheckout: a chave é derivada de dado de terceiro, e nenhuma
  /// documentação promete unicidade entre provedores.
  @@unique([provider, idempotencyKey])
  @@index([companyId, receivedAt(sort: Desc)])
  @@index([status, receivedAt])
  @@index([externalChargeId])
  @@index([externalSubscriptionId])
}
