# Copie este arquivo para .env (dev local) e preencha os valores reais.
# Nunca commite .env com segredos reais — está no .gitignore.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados (obrigatório)
# Dev local: rode `npm run db:dev` (prisma dev) e cole as duas URLs exibidas —
# as portas são sorteadas na primeira execução, não use as do exemplo.
# Produção: connection string pooled do provedor.
DATABASE_URL="postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?sslmode=disable"

# Banco sombra, usado só pelo `prisma migrate dev` para validar migrations.
# Exigido pelo prisma.config.ts em desenvolvimento; NÃO é usado em produção,
# porque `prisma migrate deploy` não cria banco sombra.
#
# Precisa apontar para uma instância separada: o `prisma dev` expõe o banco como
# `template1`, e o Postgres clona `template1` em toda database nova — o sombra
# que o Prisma criaria sozinho nasceria com o schema já aplicado e o replay das
# migrations falharia com "type already exists".
SHADOW_DATABASE_URL="postgres://USUARIO:SENHA@HOST:OUTRA_PORTA/NOME_DO_BANCO?sslmode=disable"

# Auth.js (obrigatório)
# Gere com: npx auth secret
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-ou-mais-caracteres"
AUTH_URL="http://localhost:3000"

# Google OAuth (opcional — login com Google fica desativado sem isso)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis / Upstash (opcional — cache e rate limit ficam inativos sem isso)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 (opcional — upload de arquivos fica indisponível sem isso)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# Cobrança (opcional — não há código de billing ainda, só estes campos)
#
# O provedor escolhido é a ValidaPay. Os nomes abaixo ainda dizem ASAAS porque
# é o que `lib/env.ts` valida hoje, e trocá-los sem a documentação oficial da
# ValidaPay seria inventar nomes de variável. A renomeação para nomes neutros
# (PAYMENT_PROVIDER, PAYMENT_API_KEY, ...) acontece na fase de pagamentos,
# junto da migration que renomeia as colunas equivalentes em `Company`.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# E-mail transacional — Resend (opcional — e-mails só são logados sem isso)
RESEND_API_KEY=""
EMAIL_FROM="Fluxy <naoresponda@fluxy.com.br>"

# Criptografia de dados sensíveis em repouso (opcional até o primeiro uso)
ENCRYPTION_KEY=""

# Observabilidade (opcional)
SENTRY_DSN=""
