# Copie este arquivo para .env (dev local) e preencha os valores reais.
# Nunca commite .env com segredos reais — está no .gitignore.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados (obrigatório)
# Dev local: rode `npm run db:dev` (prisma dev) e cole as duas URLs exibidas —
# as portas são sorteadas na primeira execução, não use as do exemplo.
# Produção: connection string pooled do provedor.
DATABASE_URL="postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?sslmode=disable"

# Banco sombra, usado só pelo `prisma migrate dev` para validar migrations.
# Exigido pelo prisma.config.ts em desenvolvimento; NÃO é usado em produção,
# porque `prisma migrate deploy` não cria banco sombra.
#
# Precisa apontar para uma instância separada: o `prisma dev` expõe o banco como
# `template1`, e o Postgres clona `template1` em toda database nova — o sombra
# que o Prisma criaria sozinho nasceria com o schema já aplicado e o replay das
# migrations falharia com "type already exists".
SHADOW_DATABASE_URL="postgres://USUARIO:SENHA@HOST:OUTRA_PORTA/NOME_DO_BANCO?sslmode=disable"

# Banco de TESTES (obrigatório para `npm test`)
#
# Precisa ser um banco SEPARADO e descartável. `tests/helpers/prisma.ts` lê
# somente esta variável e NUNCA cai para DATABASE_URL: os testes de integração
# criam e apagam registros, e apontá-los para o banco de desenvolvimento
# corrompe dados reais — foi o que aconteceu antes desta separação existir.
#
# A guarda recusa `fluxy_dev`, `fluxy_shadow`, `gestao_pedidos` e `postgres`,
# além de host não-local e porta diferente de 5432.
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/fluxy_test?schema=public"

# Auth.js (obrigatório)
# Gere com: npx auth secret
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-ou-mais-caracteres"
AUTH_URL="http://localhost:3000"

# Google OAuth (opcional — login com Google fica desativado sem isso)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis / Upstash (opcional — cache e rate limit ficam inativos sem isso)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 (opcional — upload de arquivos fica indisponível sem isso)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# Cobrança (opcional — não há código de billing ainda, só estes campos)
#
# O provedor escolhido é a ValidaPay. Os nomes abaixo ainda dizem ASAAS porque
# é o que `lib/env.ts` valida hoje, e trocá-los sem a documentação oficial da
# ValidaPay seria inventar nomes de variável. A renomeação para nomes neutros
# (PAYMENT_PROVIDER, PAYMENT_API_KEY, ...) acontece na fase de pagamentos,
# junto da migration que renomeia as colunas equivalentes em `Company`.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# ValidaPay (opcional — sem as credenciais o pagamento fica indisponível e o
# resto do produto segue funcionando)
#
# As credenciais saem de app.validapay.com.br/integracao/api. Os HOSTS não
# aparecem aqui de propósito: derivam de VALIDAPAY_ENV em
# lib/validapay/config.ts, para não haver como misturar credencial de produção
# com host de sandbox.
#
# `production` precisa ser escolhido explicitamente — esquecer erra para o
# lado seguro.
VALIDAPAY_ENV="sandbox"
VALIDAPAY_CLIENT_ID=""
VALIDAPAY_CLIENT_SECRET=""
VALIDAPAY_SCOPE=""

# Segredo do HMAC do webhook. A ValidaPay o devolve UMA VEZ, no cadastro da
# URL (painel: Integração > Webhooks > + Webhook, ou POST /v1/users/webhooks).
#
# É o mecanismo PRINCIPAL de autenticação da notificação: cada requisição vem
# com `X-Webhook-Signature: t={timestamp},v1={hmac}`, e a assinatura é
# calculada sobre HMAC-SHA256(secret, "{timestamp}.{corpo bruto}") — cobre o
# CONTEÚDO, não só o remetente.
#
# Sem este valor a rota de webhook responde 401 a tudo. Falhar fechado é
# deliberado: aceitar quando não há o que verificar transformaria uma variável
# esquecida num endpoint público capaz de ativar assinaturas.
VALIDAPAY_WEBHOOK_SECRET=""

# Token opcional do webhook (`x-access-token`), se configurado no painel.
#
# Camada ADICIONAL, nunca substituta do HMAC: é segredo portador, autentica o
# remetente e não a mensagem. Quando preenchido, passa a ser exigido além da
# assinatura; quando vazio, o HMAC válido basta.
VALIDAPAY_WEBHOOK_TOKEN=""

# Segredo da revisão agendada de assinaturas (Vercel Cron).
#
# A Vercel envia este valor no header `Authorization: Bearer <valor>` ao invocar
# /api/cron/subscriptions. Use uma string aleatória de 16+ caracteres.
#
# Sem ele a rota recusa TODA chamada com 401 — falha fechada, sem modo
# permissivo. Nunca chega ao navegador: é variável de servidor.
CRON_SECRET=""

# E-mail transacional — Resend (opcional — e-mails só são logados sem isso)
RESEND_API_KEY=""
EMAIL_FROM="Fluxy <naoresponda@fluxy.com.br>"

# Criptografia de dados sensíveis em repouso (opcional até o primeiro uso)
ENCRYPTION_KEY=""

# Observabilidade (opcional)
SENTRY_DSN=""

# Autorização pontual para o reajuste de preço do plano standard (59/590 ->
# 29/290) executado por prisma/seed.ts.
#
# VARIÁVEL TEMPORÁRIA, de controle operacional — não é segredo, mas muda o que
# o cliente paga:
#   - só faz efeito quando vale exatamente "true";
#   - ative-a apenas na execução em que o reajuste for intencional;
#   - REMOVA logo depois — não deve permanecer "true" em lugar nenhum;
#   - não configure na Vercel nem em outro ambiente permanente.
#
# Sem ela, o seed sincroniza nome, módulos e limites normalmente e cria o plano
# `pro` se faltar, mas não encosta em nenhum preço existente.
APPLY_APPROVED_PLAN_PRICE_CHANGE=false
